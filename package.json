{
  "name": "cubewarden",
  "version": "0.1.0",
  "description": "Keep a Magic: The Gathering cube balanced against rules you write: for the whole cube, each colour and each archetype.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cubewarden": "bin/cubewarden.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:web": "node scripts/build-web.ts",
    "build:cli": "node scripts/build-cli.ts",
    "build": "npm run build:web && npm run build:cli",
    "prepack": "npm run build",
    "build:site": "npm run build:web && node scripts/build-site.ts",
    "build:proto": "node scripts/build-proto.ts"
  },
  "devDependencies": {
    "@mantine/core": "9.8.2",
    "@mantine/hooks": "9.8.2",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "files": [
    "bin/",
    "dist/",
    "web/index.html",
    "web/llms.txt",
    "web/dist/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinsimon/cubewarden.git"
  },
  "keywords": [
    "mtg",
    "magic-the-gathering",
    "cube",
    "cubecobra",
    "scryfall",
    "17lands"
  ]
}
