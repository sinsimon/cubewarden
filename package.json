{
  "name": "cubewarden",
  "version": "0.1.0",
  "description": "Keep a Magic: The Gathering cube balanced against rules you write: for the whole cube, each colour and each archetype.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cubewarden": "bin/cubewarden.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:web": "node scripts/build-web.ts",
    "build:cli": "node scripts/build-cli.ts",
    "build": "npm run build:web && npm run build:cli",
    "prepack": "npm run build",
    "build:site": "npm run build:web && node scripts/build-site.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vaadin/aura": "25.3.7",
    "@vaadin/badge": "25.3.7",
    "@vaadin/breadcrumbs": "25.3.7",
    "@vaadin/button": "25.3.7",
    "@vaadin/checkbox": "25.3.7",
    "@vaadin/combo-box": "25.3.7",
    "@vaadin/context-menu": "25.3.7",
    "@vaadin/details": "25.3.7",
    "@vaadin/dialog": "25.3.7",
    "@vaadin/grid": "25.3.7",
    "@vaadin/icon": "25.3.7",
    "@vaadin/icons": "25.3.7",
    "@vaadin/integer-field": "25.3.7",
    "@vaadin/notification": "25.3.7",
    "@vaadin/popover": "25.3.7",
    "@vaadin/radio-group": "25.3.7",
    "@vaadin/select": "25.3.7",
    "@vaadin/switch": "25.3.7",
    "@vaadin/tabs": "25.3.7",
    "@vaadin/text-field": "25.3.7",
    "@vaadin/tooltip": "25.3.7",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "files": [
    "bin/",
    "dist/",
    "web/index.html",
    "web/llms.txt",
    "web/dist/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinsimon/cubewarden.git"
  },
  "keywords": [
    "mtg",
    "magic-the-gathering",
    "cube",
    "cubecobra",
    "scryfall",
    "17lands"
  ],
  "vaadin": {
    "disableUsageStatistics": true
  }
}
