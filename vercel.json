{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:site",
  "outputDirectory": "site",
  "rewrites": [
    { "source": "/data/:path*", "destination": "https://raw.githubusercontent.com/sinsimon/cubewarden/data/:path*" }
  ],
  "headers": [
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }] }
  ]
}
